#!/usr/bin/env sh
set -eu

message_file="$1"
first_line="$(head -n 1 "$message_file")"

case "$first_line" in
  feat:*|fix:*|docs:*|style:*|refactor:*|perf:*|test:*|build:*|ci:*|chore:*|revert:*)
    exit 0
    ;;
  feat\(*\):*|fix\(*\):*|docs\(*\):*|style\(*\):*|refactor\(*\):*|perf\(*\):*|test\(*\):*|build\(*\):*|ci\(*\):*|chore\(*\):*)
    exit 0
    ;;
esac

printf '%s\n' "commit message must use Conventional Commits, for example: feat: add importer"
exit 1
